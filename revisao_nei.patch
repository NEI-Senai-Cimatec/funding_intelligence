diff --git a/www/styles.css b/www/styles.css
index 6dc7a32..ee78481 100644
--- a/www/styles.css
+++ b/www/styles.css
@@ -1018,3 +1018,111 @@ body.authenticated .auth-overlay-backdrop {
 .tab-pane[data-value="boletins_relatorios"] {
   display: none !important;
 }
+
+
+/* ─── Login no estilo SIG QuIIN (revisão NEI, nov/2026) ───────────────────── */
+#auth_overlay_root,
+.auth-overlay-backdrop {
+  background: #020e30 url("login_bg.jpg") center center / cover no-repeat !important;
+  padding: 5.5rem 1.5rem 7rem 1.5rem !important;
+}
+
+.auth-corner-text {
+  position: fixed;
+  top: 2.2rem;
+  left: 2.5rem;
+  color: #ffffff;
+  font-size: 0.9rem;
+  font-weight: 500;
+  line-height: 1.45;
+  text-shadow: 0 1px 4px rgba(0, 0, 0, 0.5);
+  z-index: 2;
+}
+
+.auth-overlay-backdrop .auth-card {
+  max-width: 420px;
+  background: rgba(255, 255, 255, 0.78);
+  -webkit-backdrop-filter: blur(10px);
+  backdrop-filter: blur(10px);
+  border: 1px solid rgba(255, 255, 255, 0.55);
+  border-radius: 24px;
+  box-shadow: 0 18px 45px rgba(0, 10, 40, 0.45);
+  position: relative;
+  z-index: 3;
+  margin: auto;
+}
+
+.auth-overlay-backdrop .auth-header {
+  margin-bottom: 1.25rem;
+}
+
+.auth-overlay-backdrop .auth-logo-radar {
+  max-height: none;
+  width: 100%;
+  max-width: 300px;
+  margin: 0 auto;
+  border-radius: 10px;
+  mix-blend-mode: multiply;
+}
+
+.auth-overlay-backdrop .auth-input {
+  background-color: #eef2fb;
+  border-color: transparent;
+}
+
+.auth-overlay-backdrop .auth-tabs-nav {
+  background: rgba(241, 245, 249, 0.7);
+}
+
+.auth-footer-logos {
+  position: fixed;
+  left: 0;
+  right: 0;
+  bottom: 0;
+  height: 76px;
+  background: #f8fafc;
+  border-top: 3px solid #1e40af;
+  display: flex;
+  align-items: center;
+  justify-content: center;
+  gap: 2.5rem;
+  z-index: 2;
+}
+
+.auth-footer-logos img {
+  height: 44px;
+  width: auto;
+  object-fit: contain;
+}
+
+@media (max-width: 640px) {
+  #auth_overlay_root,
+  .auth-overlay-backdrop {
+    flex-direction: column !important;
+    align-items: stretch !important;
+    justify-content: flex-start !important;
+    padding: 1rem 1rem 0 1rem !important;
+  }
+  .auth-corner-text {
+    position: static;
+    order: 1;
+    font-size: 0.75rem;
+    margin-bottom: 1rem;
+  }
+  .auth-overlay-backdrop .auth-card {
+    order: 2;
+    margin: 0 auto;
+    flex-shrink: 0;
+  }
+  .auth-footer-logos {
+    position: static;
+    order: 3;
+    flex-shrink: 0;
+    margin: 1.5rem -1rem 0 -1rem;
+    height: 60px;
+    gap: 1.25rem;
+  }
+  .auth-footer-logos img {
+    height: 32px;
+  }
+}
